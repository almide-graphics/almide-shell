// almide-shell launcher — type to find an application, Enter to start it
//
//   almide run launcher.almd        (bind it to a key: bind = SUPER, SPACE, exec, launcher)
//
// A layer surface over everything, centred, holding the keyboard: typing
// (an input method composes too) filters the installed applications
// (apps.almd), Up/Down or the pointer move the selection, Enter or a click
// starts it through Hyprland, Escape closes. What it shows is a ceangal view
// (`view`), laid out by ceangal and drawn on the CPU.

import process
import ceangal.cpu_draw as draw
import ceangal.render as render
import ceangal.view as v
import snaidhm.wayland.window as window
import snaidhm.native.fonts as fonts
import snaidhm.cpu.canvas as canvas
import self.apps as apps
import self.bar as bar
import self.config as config
import self.hypr as hypr

let WIDTH = 640
let ROWS = 8
let ROW_H = 40
let HEAD_H = 56
/// Room kept between the launcher and the edges of a small output.
let EDGE = 16

fn height_for(rows: Int) -> Int = HEAD_H + 12 + rows * ROW_H

/// A theme colour (#rrggbb[aa]) as ceangal's.
fn colour(hex: String) -> v.Color = {
  let c = bar.rgba(hex)
  v.rgba(c.0, c.1, c.2, c.3)
}

/// The launcher: the search field over the matching applications, the
/// selected one highlighted. A click on a row means its index + 1.
fn view(shown: List[apps.App], sel: Int, rows: Int) -> v.View = {
  let th = config.THEME
  let listed = shown |> list.take(rows) |> list.enumerate |> list.map(((i, a)) => app_row(a, i, i == sel))
  let body = if list.len(shown) == 0 then [v.text("No matches") |> v.font(th.font_size) |> v.color(colour(th.dim)) |> v.px(14.0) |> v.py(12.0)]
             else listed
  v.col([
    v.text_field("Search applications") |> v.font(th.font_size + 3.0) |> v.color(colour(th.foreground)) |> v.h(int.to_float(HEAD_H - 8)),
    v.col([]) |> v.h(1.0) |> v.mx(8.0) |> v.bg(colour(th.dim)) |> v.opacity(0.6),
    v.col(body) |> v.py(5.0),
  ])
  |> v.px(8.0)
  |> v.bg(colour(th.background))
  |> v.rounded(14.0)
}

/// One application: its name, then what it is, dimmed.
fn app_row(a: apps.App, i: Int, selected: Bool) -> v.View = {
  let th = config.THEME
  let ink = if selected then colour(th.background) else colour(th.foreground)
  let faint = if selected then colour(th.background) else colour(th.dim)
  v.row([
    v.text(a.name) |> v.font(th.font_size + 1.0) |> v.color(ink),
    v.text(a.comment) |> v.font(th.font_size - 1.0) |> v.color(faint) |> v.opacity(0.9),
  ])
  |> v.gap(12.0)
  |> v.align(v.ALIGN_CENTER)
  |> v.px(14.0)
  |> v.h(int.to_float(ROW_H - 4))
  |> v.my(2.0)
  |> v.rounded(8.0)
  |> v.bg(if selected then colour(th.accent) else v.transparent)
  |> v.on_click(i + 1)
}

/// A frame for the launcher: the window's pixels, drawn on in units.
fn frame() -> canvas.Canvas = canvas.scaled(window.width(), window.height(), window.scale())

/// Start `app`: through Hyprland when it runs us, else directly.
effect fn launch(app: apps.App) -> Result[Unit, String] = {
  match hypr.dispatch("exec ${app.exec}") {
    ok(_) => ok(()),
    err(_) => {
      let _ = process.spawn("sh", ["-c", app.exec])!
      ok(())
    },
  }
}

effect fn main() -> Unit = {
  let all = apps.all()!
  // Stretched over the output first, to learn its room (nothing is shown
  // before the first frame); then as big as fits, anchored to no edge —
  // centred. Keyboard: exclusive.
  if window.open_layer("almide-launcher", layer: window.Overlay,
    anchor: [window.TopEdge, window.BottomEdge, window.LeftEdge, window.RightEdge], keyboard: window.ExclusiveKeyboard)! then {
    let room = window.extent()
    let w = int.min(WIDTH, float.to_int(room.0) - 2 * EDGE)
    let rows = int.clamp((float.to_int(room.1) - 2 * EDGE - height_for(0)) / ROW_H, 1, ROWS)
    window.anchor_layer([])!
    window.resize_layer(w, height_for(rows))!
    window.set_ime(true)!
    let faces = fonts.system()!
    render.set_measure((t, size) => canvas.measure(faces, draw.code_points(t), size))
    var query = ""
    var field = draw.no_field()
    var sel = 0
    var shown = apps.filter(all, query)
    var items = render.render(view(shown, sel, rows), window.extent().0, window.extent().1)
    var dirty = true
    // Where the pointer was last: a row is selected by moving onto it, not by
    // the pointer resting where the launcher opened.
    var pointer_at = (0.0 - 1.0, 0.0 - 1.0)
    var going = true
    while going {
      if dirty then {
        shown = apps.filter(all, query)
        items = render.render(view(shown, sel, rows), window.extent().0, window.extent().1)
        let p = draw.draw(frame(), faces, items, { ...field, typed: draw.code_points(query) }, draw.no_scroll())
        window.present(p.canvas.px)!
        // The candidate window opens beside the caret.
        window.set_ime_area(p.caret_x, p.caret_y, 1.0, p.caret_h)!
        dirty = false
      } else ()
      going = window.pump(0 - 1)!
      dirty = window.resized()
      var kind = window.next_event()
      while kind != window.NONE {
        let under = render.hit(items, window.event_x(), window.event_y(), 0.0)
        if kind == window.TEXT then {
          query = query + string.from_codepoint(window.event_code())
          sel = 0
          dirty = true
        } else if kind == window.COMPOSE then {
          field = { ...field, compose: draw.code_points(window.event_text()), from: window.event_code(), to: window.event_end() }
          dirty = true
        } else if kind == window.MOUSE_MOVE then {
          // The pointer, moved, selects the row it is over.
          window.set_cursor(if under > 0 then window.Hand else window.Arrow)!
          let at = (window.event_x(), window.event_y())
          let moved = pointer_at.0 >= 0.0 and at != pointer_at
          pointer_at = at
          if moved and under > 0 and under - 1 != sel then {
            sel = under - 1
            dirty = true
          } else ()
        } else if kind == window.MOUSE_DOWN and window.event_code() == 0 and under > 0 then {
          match list.get(shown, under - 1) {
            some(app) => launch(app)!,
            none => (),
          }
          going = false
        } else if kind == window.KEY then {
          let k = window.event_code()
          if k == window.KEY_ESCAPE then { going = false }
          else if k == window.KEY_BACKSPACE then {
            let cs = string.chars(query)
            query = cs |> list.take(int.max(0, list.len(cs) - 1)) |> list.join("")
            sel = 0
            dirty = true
          } else if k == window.KEY_DOWN or k == window.KEY_TAB then {
            sel = int.min(sel + 1, int.max(0, int.min(rows, list.len(shown)) - 1))
            dirty = true
          } else if k == window.KEY_UP then {
            sel = int.max(0, sel - 1)
            dirty = true
          } else if k == window.KEY_ENTER then {
            match list.get(shown, sel) {
              some(app) => launch(app)!,
              none => (),
            }
            going = false
          } else ()
        } else ()
        kind = window.next_event()
      }
    }
  } else {
    println("no layer-shell surface: needs a Wayland compositor with wlr-layer-shell (Hyprland, sway)")
  }
}
