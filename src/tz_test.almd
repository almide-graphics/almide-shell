// tz: POSIX TZ rules (the footer of every TZif file, and the whole zone when
// $TZ is a rule). test/tz_oracle.py checks the TZif side against Python's
// zoneinfo over 18 zones from 1900 to 2100.

import self.tz as tz

fn at(y: Int, m: Int, d: Int, h: Int, min: Int) -> Int = datetime.from_parts(y, m, d, h, min, 0)

test "a fixed offset: POSIX signs are west of UTC" {
  let z = tz.from_rule("JST-9")
  assert_eq(tz.offset_at(z, at(2026, 9, 29, 0, 0)), 9 * 3600)
  assert_eq(tz.offset_at(tz.from_rule("<-03>3"), at(2026, 1, 1, 0, 0)), 0 - 3 * 3600)
  assert_eq(tz.offset_at(tz.from_rule("IST-5:30"), at(2026, 1, 1, 0, 0)), 5 * 3600 + 1800)
}

test "European summer time: last Sunday of March 01:00 UTC to last Sunday of October" {
  let z = tz.from_rule("CET-1CEST,M3.5.0,M10.5.0/3")
  // 2026-03-29 is the last Sunday of March; the change is 02:00 local = 01:00 UTC.
  assert_eq(tz.offset_at(z, at(2026, 3, 29, 0, 59)), 3600)
  assert_eq(tz.offset_at(z, at(2026, 3, 29, 1, 0)), 7200)
  // 2026-10-25, 03:00 local summer time = 01:00 UTC.
  assert_eq(tz.offset_at(z, at(2026, 10, 25, 0, 59)), 7200)
  assert_eq(tz.offset_at(z, at(2026, 10, 25, 1, 0)), 3600)
}

test "a southern-hemisphere rule wraps the year end" {
  // Sydney: summer from the first Sunday of October to the first of April.
  let z = tz.from_rule("AEST-10AEDT,M10.1.0,M4.1.0/3")
  assert_eq(tz.offset_at(z, at(2027, 1, 15, 0, 0)), 11 * 3600)
  assert_eq(tz.offset_at(z, at(2027, 7, 15, 0, 0)), 10 * 3600)
}

test "localize moves UTC fields to local ones" {
  let z = tz.from_rule("JST-9")
  assert_eq(datetime.hour(tz.localize(z, at(2026, 9, 29, 20, 0))), 5)
}
